# Petmate ROS 2 Jazzy image (Raspberry Pi 5, linux/arm64; also builds on amd64).
# Build context: petmate/robot   ->  docker build -f docker/Dockerfile.ros -t petmate/ros:0.1 .
ARG ROS_DISTRO=jazzy
FROM ros:${ROS_DISTRO}-ros-base AS base

ARG ROS_DISTRO
# Pin upstream drivers for reproducible builds (set to commit SHAs in CI).
ARG UNILIDAR_SDK2_REPO=https://github.com/unitreerobotics/unilidar_sdk2.git
ARG UNILIDAR_SDK2_REF=main
ARG LIVOX_SDK2_REPO=https://github.com/Livox-SDK/Livox-SDK2.git
ARG LIVOX_SDK2_REF=master
ARG LIVOX_DRIVER2_REPO=https://github.com/Livox-SDK/livox_ros_driver2.git
ARG LIVOX_DRIVER2_REF=master

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=${ROS_DISTRO} \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    PYTHONUNBUFFERED=1

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
        git build-essential cmake python3-colcon-common-extensions python3-rosdep \
        python3-zmq python3-serial python3-yaml python3-pytest \
        libpcl-dev libeigen3-dev \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        ros-${ROS_DISTRO}-xacro \
        ros-${ROS_DISTRO}-robot-state-publisher \
        ros-${ROS_DISTRO}-joint-state-publisher \
        ros-${ROS_DISTRO}-navigation2 \
        ros-${ROS_DISTRO}-nav2-mppi-controller \
        ros-${ROS_DISTRO}-nav2-regulated-pure-pursuit-controller \
        ros-${ROS_DISTRO}-slam-toolbox \
        ros-${ROS_DISTRO}-robot-localization \
        ros-${ROS_DISTRO}-twist-mux \
        ros-${ROS_DISTRO}-pointcloud-to-laserscan \
        ros-${ROS_DISTRO}-pcl-conversions \
        ros-${ROS_DISTRO}-pcl-ros \
        ros-${ROS_DISTRO}-diagnostic-updater \
        ros-${ROS_DISTRO}-tf2-ros \
        ros-${ROS_DISTRO}-tf2-tools \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------- Livox-SDK2 (system lib)
# GCC 13 (Ubuntu 24.04) needs <cstdint> force-included for this SDK.
RUN git clone --depth 1 -b ${LIVOX_SDK2_REF} ${LIVOX_SDK2_REPO} /tmp/Livox-SDK2 \
    && cmake -S /tmp/Livox-SDK2 -B /tmp/Livox-SDK2/build \
         -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS="-include cstdint" \
    && cmake --build /tmp/Livox-SDK2/build -j"$(nproc)" \
    && cmake --install /tmp/Livox-SDK2/build \
    && ldconfig && rm -rf /tmp/Livox-SDK2

# ---------------------------------------------------------------- driver underlay
# unilidar_sdk2: the ROS 2 package references the in-repo unitree_lidar_sdk via
# a relative path, so the repo is kept intact and its ROS 2 workspace built in place.
RUN git clone ${UNILIDAR_SDK2_REPO} /opt/unilidar_sdk2 \
    && git -C /opt/unilidar_sdk2 checkout ${UNILIDAR_SDK2_REF} \
    && source /opt/ros/${ROS_DISTRO}/setup.bash \
    && cd /opt/unilidar_sdk2/unitree_lidar_ros2 \
    && colcon build --merge-install --install-base /opt/drivers \
         --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && rm -rf build log

# livox_ros_driver2 selects its ROS 2 manifest by copying package_ROS2.xml.
RUN mkdir -p /opt/livox_ws/src \
    && git clone --depth 1 -b ${LIVOX_DRIVER2_REF} ${LIVOX_DRIVER2_REPO} /opt/livox_ws/src/livox_ros_driver2 \
    && cp /opt/livox_ws/src/livox_ros_driver2/package_ROS2.xml /opt/livox_ws/src/livox_ros_driver2/package.xml \
    && source /opt/ros/${ROS_DISTRO}/setup.bash \
    && cd /opt/livox_ws \
    && colcon build --merge-install --install-base /opt/drivers \
         --cmake-args -DCMAKE_BUILD_TYPE=Release -DROS_EDITION=ROS2 -DHUMBLE_ROS=humble \
    && rm -rf build log

# ---------------------------------------------------------------- Petmate workspace
WORKDIR /opt/petmate_ws
COPY ros2_ws/src ./src
RUN source /opt/ros/${ROS_DISTRO}/setup.bash && source /opt/drivers/setup.bash \
    && colcon build --merge-install --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && rm -rf build log \
    && python3 -m pytest -q src/petmate_base/test src/petmate_bridge/test src/petmate_behavior/test

COPY docker/entrypoint.sh /entrypoint.sh
COPY docker/cyclonedds.xml /etc/petmate/cyclonedds.xml
RUN chmod +x /entrypoint.sh
ENV CYCLONEDDS_URI=file:///etc/petmate/cyclonedds.xml

ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "petmate_bringup", "bringup.launch.py"]
