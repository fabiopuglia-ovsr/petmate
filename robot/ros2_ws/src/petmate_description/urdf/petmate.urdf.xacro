<?xml version="1.0"?>
<!-- Petmate EVT1 geometry, INTERFACES.md §1.
     All z values given in §1 (lidar 0.235, front camera 0.135, rear camera 0.110) are interpreted as
     heights above the floor (base_footprint); base_link sits at z = 0.036
     (wheel axle height = wheel radius). -->
<robot name="petmate" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="lidar" default="l2"/>
  <!-- LiDAR mounting orientation is NOT specified in INTERFACES.md §1.
       Default upright (dome up). Override e.g. lidar_roll:=3.14159 for an
       inverted mount, or lidar_pitch for a tilted one. -->
  <xacro:arg name="lidar_roll" default="0.0"/>
  <xacro:arg name="lidar_pitch" default="0.0"/>
  <xacro:arg name="lidar_yaw" default="0.0"/>

  <xacro:property name="PI" value="3.141592653589793"/>
  <xacro:property name="body_radius" value="0.170"/>
  <xacro:property name="body_height" value="0.165"/>
  <xacro:property name="body_clearance" value="0.015"/>  <!-- floor to body bottom (assumed) -->
  <xacro:property name="base_z" value="0.036"/>
  <xacro:property name="wheel_radius" value="0.036"/>
  <xacro:property name="wheel_width" value="0.020"/>
  <xacro:property name="track" value="0.260"/>
  <xacro:property name="caster_radius" value="0.020"/>
  <xacro:property name="caster_x" value="0.130"/>
  <xacro:property name="lidar_z" value="0.235"/>
  <xacro:property name="cam_x" value="0.155"/>
  <xacro:property name="cam_front_z" value="0.135"/>  <!-- front camera in display bezel, above the bowl recess -->
  <xacro:property name="cam_rear_z" value="0.110"/>
  <xacro:property name="cam_pitch" value="${10.0 * PI / 180.0}"/>  <!-- -10 deg (nose down) => +pitch in REP-103 -->

  <material name="shell"><color rgba="0.95 0.93 0.88 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="lidar"><color rgba="0.25 0.25 0.3 1"/></material>

  <xacro:macro name="cyl_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
  </xacro:macro>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_clearance + body_height/2 - base_z}"/>
      <geometry><cylinder radius="${body_radius}" length="${body_height}"/></geometry>
      <material name="shell"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_clearance + body_height/2 - base_z}"/>
      <geometry><cylinder radius="${body_radius}" length="${body_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${body_clearance + body_height/2 - base_z}"/>
      <mass value="4.0"/>
      <xacro:cyl_inertia m="4.0" r="${body_radius}" h="${body_height}"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="drive_wheel" params="side y">
    <link name="wheel_${side}_link">
      <visual>
        <origin rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <origin rpy="${PI/2} 0 0"/>
        <mass value="0.12"/>
        <xacro:cyl_inertia m="0.12" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>
    <joint name="wheel_${side}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${side}_link"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left" y="${track/2}"/>
  <xacro:drive_wheel side="right" y="${-track/2}"/>

  <xacro:macro name="caster" params="name x">
    <link name="caster_${name}_link">
      <visual><geometry><sphere radius="${caster_radius}"/></geometry><material name="dark"/></visual>
      <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
      <inertial><mass value="0.03"/>
        <inertia ixx="5e-6" ixy="0" ixz="0" iyy="5e-6" iyz="0" izz="5e-6"/></inertial>
    </link>
    <joint name="caster_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_${name}_link"/>
      <origin xyz="${x} 0 ${caster_radius - base_z}"/>
    </joint>
  </xacro:macro>

  <xacro:caster name="front" x="${caster_x}"/>
  <xacro:caster name="rear" x="${-caster_x}"/>

  <!-- 3D LiDAR, optical centre at z = 0.235 m above floor, centred on the back -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 -0.02"/>
      <geometry><cylinder radius="0.038" length="0.070"/></geometry>
      <material name="lidar"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_z - base_z}" rpy="$(arg lidar_roll) $(arg lidar_pitch) $(arg lidar_yaw)"/>
  </joint>

  <!-- MCU IMU (ICM-42688-P). Mounting position not specified in §1: assumed at
       the geometric centre, axes aligned with base_link. Update when PCB placed. -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <link name="camera_front_link"/>
  <joint name="camera_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_front_link"/>
    <origin xyz="${cam_x} 0 ${cam_front_z - base_z}" rpy="0 ${cam_pitch} 0"/>
  </joint>

  <link name="camera_rear_link"/>
  <joint name="camera_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_rear_link"/>
    <origin xyz="${-cam_x} 0 ${cam_rear_z - base_z}" rpy="0 ${cam_pitch} ${PI}"/>
  </joint>

  <!-- Optical frames (z forward, x right, y down) for image consumers -->
  <link name="camera_front_optical_frame"/>
  <joint name="camera_front_optical_joint" type="fixed">
    <parent link="camera_front_link"/>
    <child link="camera_front_optical_frame"/>
    <origin rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>
  <link name="camera_rear_optical_frame"/>
  <joint name="camera_rear_optical_joint" type="fixed">
    <parent link="camera_rear_link"/>
    <child link="camera_rear_optical_frame"/>
    <origin rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>
</robot>
