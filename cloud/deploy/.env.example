# ---- public names
API_DOMAIN=api.petmate.example
TURN_HOST=turn.petmate.example
ACME_EMAIL=ops@petmate.example
PUBLIC_BASE_URL=https://api.petmate.example

# ---- API
JWT_SECRET=change-me-64-random-chars
# DATABASE_URL=postgresql+psycopg://petmate:pw@db:5432/petmate   (default: SQLite in /data)
ALLOW_TOFU=false
CORS_ORIGINS=*
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_DEVICE_AUTH=20/60
MAX_CLIP_MB=100
LOG_LEVEL=INFO

# ---- TURN (must match coturn static-auth-secret)
TURN_SECRET=change-me-another-long-random-secret
TURN_REALM=petmate.example
TURN_EXTERNAL_IP=203.0.113.10
TURN_TTL_S=3600
# Optional explicit URL lists (comma separated); default derived from TURN_HOST:
# STUN_URLS=stun:turn.petmate.example:3478   (no TURN_HOST → stun:stun.l.google.com:19302; "none" disables)
# TURN_URLS=turn:turn.petmate.example:3478?transport=udp,turn:turn.petmate.example:3478?transport=tcp,turns:turn.petmate.example:5349?transport=tcp

# ---- FCM HTTP v1 (leave empty → push is only logged)
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
# FCM_CREDENTIALS_FILE=/run/secrets/fcm.json
