# Petmate cloud — MVP developer setup (docs/MVP.md): laptop in the home LAN, plain HTTP :8000.
# Shared by docker-compose.dev.yml (env_file) and ../run_dev.sh (values already set in the
# shell environment win). NOT for production.
JWT_SECRET=petmate-dev-only-jwt-secret-change-me-0123456789
ALLOW_TOFU=true
PORT=8000
CORS_ORIGINS=*
RATE_LIMIT_AUTH=60/60
RATE_LIMIT_DEVICE_AUTH=60/60
LOG_LEVEL=INFO
# STUN only by default (no TURN). STUN_URLS=none → host candidates only (LAN without internet).
STUN_URLS=stun:stun.l.google.com:19302
# TURN is enabled only with the `turn` compose profile; see README "TURN per test da remoto".
TURN_SECRET=petmate-dev-turn-secret
TURN_URLS=
